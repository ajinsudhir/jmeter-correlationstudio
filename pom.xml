<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.correlationstudio</groupId>
  <artifactId>jmeter-correlationstudio</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Correlation Studio for JMeter</name>
  <description>Correlation, Playwright-based recording, release-to-release
    comparison, and render-timing capture for Apache JMeter.</description>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Match this to the JMeter version you are deploying into -->
    <jmeter.version>5.6.3</jmeter.version>
  </properties>

  <dependencies>
    <!-- Core JMeter classes: GuiPackage, JMeterTreeModel, SaveService, etc. -->
    <dependency>
      <groupId>org.apache.jmeter</groupId>
      <artifactId>ApacheJMeter_core</artifactId>
      <version>${jmeter.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- MenuCreator / GUI plugin base classes -->
    <dependency>
      <groupId>org.apache.jmeter</groupId>
      <artifactId>ApacheJMeter_components</artifactId>
      <version>${jmeter.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- HTTPSamplerBase (used by ScriptRunner to cap connect/response timeouts) -->
    <dependency>
      <groupId>org.apache.jmeter</groupId>
      <artifactId>ApacheJMeter_http</artifactId>
      <version>${jmeter.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>jmeter-correlationstudio</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>
      <plugin>
        <!-- Populates Implementation-Version in the jar's manifest from this
             pom's own <version> above, so the in-dialog footer can read the
             version at runtime without it drifting out of sync with a
             hardcoded string. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
